{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Atlas",
  "version": "0.1.1",
  "identifier": "io.github.lucasalt40.projectatlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Atlas",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Lucas Alt",
    "copyright": "Copyright © 2026 Lucas Alt. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Orquestre agentes de IA em projetos de desenvolvimento",
    "longDescription": "Project Atlas é um aplicativo desktop de código aberto para orquestrar agentes de IA em projetos locais. Código-fonte: https://github.com/LucasAlt40/project-atlas",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
