{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window: only the app's own commands, listening to events emitted by the core, and the native folder picker. No filesystem, shell, process or network plugins are granted.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-personalities",
    "allow-create-personality",
    "allow-update-personality",
    "allow-delete-personality",
    "allow-restore-default-personalities",
    "allow-list-runtimes",
    "allow-list-agents",
    "allow-create-agent",
    "allow-update-agent",
    "allow-set-agent-result-contract",
    "allow-delete-agent",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-update-workspace",
    "allow-delete-workspace",
    "allow-add-agent-to-workspace",
    "allow-remove-agent-from-workspace",
    "allow-get-project-context",
    "allow-get-settings",
    "allow-set-language",
    "allow-select-workspace",
    "allow-send-message",
    "allow-list-messages",
    "allow-list-executions",
    "allow-get-agent-usage",
    "allow-get-workspace-usage",
    "allow-get-workspace-security",
    "allow-get-agent-permissions",
    "allow-set-agent-permission-profile",
    "allow-list-pending-approvals",
    "allow-resolve-approval",
    "allow-get-execution-terminal",
    "allow-execution-interrupt",
    "allow-execution-terminate",
    "allow-execution-terminal-input",
    "allow-execution-terminal-resize",
    "allow-list-execution-worktrees",
    "allow-merge-execution",
    "allow-analyze-project",
    "allow-initialize-project",
    "allow-get-project-harness",
    "allow-refresh-project-harness",
    "allow-preview-task-context",
    "allow-list-workflows",
    "allow-get-workflow",
    "allow-list-workflow-templates",
    "allow-select-workflow-template",
    "allow-create-workflow",
    "allow-create-workflow-from-template",
    "allow-update-workflow",
    "allow-delete-workflow",
    "allow-validate-workflow",
    "allow-start-workflow",
    "allow-pause-workflow",
    "allow-resume-workflow",
    "allow-cancel-workflow",
    "allow-answer-workflow-interaction",
    "allow-list-pending-interactions",
    "allow-get-workflow-execution",
    "allow-list-workflow-executions",
    "allow-get-workflow-changes",
    "allow-get-workflow-diff",
    "allow-apply-workflow-changes",
    "allow-keep-workflow-changes",
    "allow-discard-workflow-changes",
    "allow-list-ides",
    "allow-get-live-workspace",
    "allow-refresh-live-workspace",
    "allow-get-live-file",
    "allow-get-live-diff",
    "allow-open-workflow-in-ide",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "notification:default"
  ]
}
