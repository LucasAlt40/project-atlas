{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window: only the app's own commands, listening to events emitted by the core, and the native folder picker. No filesystem, shell, process or network plugins are granted.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-personalities",
    "allow-create-personality",
    "allow-update-personality",
    "allow-delete-personality",
    "allow-restore-default-personalities",
    "allow-list-runtimes",
    "allow-list-agents",
    "allow-create-agent",
    "allow-update-agent",
    "allow-delete-agent",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-update-workspace",
    "allow-delete-workspace",
    "allow-add-agent-to-workspace",
    "allow-remove-agent-from-workspace",
    "allow-get-project-context",
    "allow-get-settings",
    "allow-set-language",
    "allow-select-workspace",
    "allow-send-message",
    "allow-list-messages",
    "allow-list-executions",
    "allow-get-agent-usage",
    "allow-get-workspace-usage",
    "allow-get-workspace-security",
    "allow-get-agent-permissions",
    "allow-set-agent-permission-profile",
    "allow-list-pending-approvals",
    "allow-resolve-approval",
    "allow-get-execution-terminal",
    "allow-execution-interrupt",
    "allow-execution-terminate",
    "allow-execution-terminal-input",
    "allow-execution-terminal-resize",
    "allow-list-execution-worktrees",
    "allow-merge-execution",
    "allow-analyze-project",
    "allow-initialize-project",
    "allow-get-project-harness",
    "allow-refresh-project-harness",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
