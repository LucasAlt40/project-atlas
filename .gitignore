# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ────────────────────────────────────────────
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/

# ── Rust / Tauri ────────────────────────────────────────────
# Compiled artifacts (several GB)
src-tauri/target/
# Generated by `tauri-build` on every build (schemas and per-command permissions)
src-tauri/gen/
src-tauri/permissions/autogenerated/
# Platform bundles / installers produced by `tauri build`
*.rs.bk
*.dmg
*.msi
*.exe
*.AppImage
*.deb
*.rpm

# ── Environment and secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets/
# Atlas user data (workspaces, agents, settings) lives in the OS app-data
# directory, never in the repo; this is only a safety net.
config.json
config.json.corrupt
config.json.tmp

# ── Logs and caches ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/
.npm/
tmp/
temp/

# ── Operating systems ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

